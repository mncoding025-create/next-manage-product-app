# คัดลอกไฟล์นี้เป็น .env แล้วแก้ให้ตรงกับเครื่องของตัวเอง
# ค่าเริ่มต้นของ XAMPP: user = root, ไม่มีรหัสผ่าน

# ใช้โดย Prisma CLI (migrate, generate) รูปแบบ mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@127.0.0.1:3306/stock_product_db"

# ใช้โดยแอป Next.js (lib/prisma.ts)
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USERNAME="root"
DATABASE_PASSWORD=""
DATABASE_NAME="stock_product_db"
